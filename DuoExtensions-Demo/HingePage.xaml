<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DuoExtensionsDemo.HingePage" Title="Hinge status">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="Follow the fold" Style="{StaticResource Heading}" />
            <Label Text="Open or close the Duo hinge to see live readings from this window's native view hierarchy." />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Hinge status" Style="{StaticResource SectionTitle}" />
                    <Label x:Name="StatusLabel" AutomationId="HingeStatus" Style="{StaticResource Value}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" />
                    <Label Text="Angle in degrees" Style="{StaticResource Caption}" />
                    <Label x:Name="AngleLabel" AutomationId="HingeAngle" Style="{StaticResource Value}" />
                    <Label x:Name="AvailabilityLabel" AutomationId="HingeAvailability" />
                </VerticalStackLayout>
            </Border>
            <Label Text="One physical hinge, one observer per window" Style="{StaticResource SectionTitle}" />
            <Label Text="The injected service is shared across the app. ForWindow returns the observer for this window, because UIKit provides hinge readings through a view hierarchy, not a global device sensor." />
            <Label Text="No reading is not the same as a closed hinge. When this hierarchy has no hinge data, both status and angle show Unavailable."
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
