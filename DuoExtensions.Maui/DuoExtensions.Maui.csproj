<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0;net10.0-ios27.1</TargetFrameworks>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>DuoExtensions.Maui</PackageId>
		<Version>0.1.0-preview.1</Version>
		<Authors>PieEatingNinjas</Authors>
		<Description>Adaptive toolbars in .NET MAUI Shell and window-aware hinge monitoring for iPhone Duo.</Description>
		<PackageTags>maui;ios;iphone;duo;toolbar;hinge</PackageTags>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/PieEatingNinjas/DuoExtensions.Maui</RepositoryUrl>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>assets/logo.png</PackageIcon>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
	</PropertyGroup>
	<ItemGroup>
		<None Include="../README.md" Pack="true" PackagePath="/" />
		<None Include="../assets/logo.png" Pack="true" PackagePath="assets/" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
	</ItemGroup>
</Project>
